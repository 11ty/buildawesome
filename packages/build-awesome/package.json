{
  "name": "@awesome.me/buildawesome",
  "description": "A simpler way to build awesome web sites.",
  "version": "PRIVATE",
  "private": true,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/Core.js"
    },
    "./UserConfig": {
      "types": "./types/UserConfig.d.ts"
    },
    "./plugins/html-base": {
      "types": "./types/Plugins/HtmlBasePlugin.d.ts",
      "default": "./src/Plugins/HtmlBasePlugin.js"
    },
    "./plugins/i18n": "./src/Plugins/I18nPlugin.js",
    "./plugins/id-attribute": "./src/Plugins/IdAttributePlugin.js",
    "./plugins/input-path-to-url": {
      "types": "./types/Plugins/InputPathToUrl.d.ts",
      "default": "./src/Plugins/InputPathToUrl.js"
    },
    "./plugins/preserve-closing-tags": "./src/Plugins/PreserveClosingTagsPlugin.js",
    "./plugins/render": "./src/Plugins/RenderPlugin.js",
    "./utils/git": "./src/Util/Git.js"
  },
  "scripts": {
    "test": "",
    "typescript": "tsc"
  },
  "bin": {
    "buildawesome": "cmd.js"
  },
  "license": "MIT",
  "author": "Zach Leatherman (https://zachleat.com/)",
  "repository": {
    "type": "git",
    "url": "git://github.com/11ty/buildawesome.git"
  },
  "bugs": "https://github.com/11ty/buildawesome/issues",
  "homepage": "https://build.awesome.me/",
  "dependencies": {
    "@11ty/eleventy": "file:../../"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
